# Clave de API de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini. Puedes cambiarlo sin tocar el código.
GEMINI_MODEL=gemini-3.1-flash-lite

# Puerto del servidor de Lumen IA
PORT=3001

# Máximo de mensajes por minuto y por IP
LUMEN_RATE_LIMIT=30

# Cuenta de administrador inicial (se crea sola al arrancar el servidor).
# Cambia la contraseña antes de desplegar.
ADMIN_EMAIL=admin@talemtumclass.com
ADMIN_PASSWORD=Admin1234

# Ruta opcional de la base SQLite (por defecto database/talentumclass.db)
# DATABASE_PATH=./database/talentumclass.db
